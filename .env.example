# Supabase project URL — found in: Supabase dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key — found in: Supabase dashboard → Settings → API → Project API keys → anon public
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...

# Supabase service role key — found in: Supabase dashboard → Settings → API → Project API keys → service_role
# KEEP SECRET — never expose this to the client or commit it to source control
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Field-level encryption key for sensitive settings (BSB, account number)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# KEEP SECRET — never expose or commit this value
SETTINGS_ENCRYPTION_KEY=your-64-char-hex-key-here

# Resend — transactional email (new-entry alerts to admins, logging reminders)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=notifications@splitshift.com.au

# Vercel Cron secret — Vercel sends it as "Authorization: Bearer <CRON_SECRET>"
# to /api/cron/* routes. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your-random-secret

# Optional: public app URL used in emails, and the timezone reminders are counted in
# NEXT_PUBLIC_APP_URL=https://www.splitshift.com.au
# REMINDER_TIMEZONE=Australia/Sydney
